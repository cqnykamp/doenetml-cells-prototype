<mathInput name="r" prefill="3"/>
<graph><point name="p">(-3,5)</point><circle name="c" center="$p" radius="$r"/>
<circle name="e"/>
<point name="a">(1,2)</point><point name="b">(4,7)</point><point name="d">(0,6)</point>
<circle name="t" through="$a $b $d"/>
<circle name="u" center="$a" through="$b"/>
<point name="on" x="5" y="5" constrainTo="$u"/>
</graph>
<point name="cc" extend="$c.center"/>
