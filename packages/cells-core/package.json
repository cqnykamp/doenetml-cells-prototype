{
  "name": "@doenet/cells-core",
  "version": "0.1.0",
  "private": true,
  "description": "A DoenetML core organized around a flat list of f64 cells: Rust, compiled to wasm.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./pkg/*": "./pkg/*",
    "./cdast-encode": {
      "types": "./scripts/cdast-encode.d.mts",
      "import": "./scripts/cdast-encode.mjs"
    }
  },
  "scripts": {
    "build": "npm run build:rust",
    "build:rust": "wasm-pack build crates/cells-wasm --target web --release --out-dir ../../pkg --out-name cells_wasm",
    "test": "cargo test --workspace",
    "lint": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "fixtures": "scripts/gen-fixtures.sh",
    "bench": "cargo bench -p cells-bench",
    "stats": "cargo run --release -p cells-bench --bin stats",
    "perf-diff": "scripts/perf-diff.sh",
    "golden-diff": "scripts/golden-diff.sh",
    "parse": "node scripts/parse-dast.mjs"
  }
}
